# ─────────────────────────────────────────────────────────
# LuxeStay Backend — Environment Variables
# Copy this file to .env for local development.
# On Railway: set these in the Railway dashboard → Variables tab.
# ─────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB — User Panel Database (required) ──────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/luxestay?retryWrites=true&w=majority

# ── MongoDB — Admin Panel Database (required) ─────────────
MONGO_ADMIN_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/controller?retryWrites=true&w=majority

# ── JWT Secret (required — use a long random string) ──────
JWT_SECRET=your_jwt_secret_here

# ── CORS — comma-separated list of allowed frontend URLs ──
# Leave empty to allow all origins (testing only)
# Example: https://your-frontend.vercel.app,https://your-admin.vercel.app
CLIENT_ORIGIN=

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email (Resend) — optional ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=LuxeStay <onboarding@resend.dev>
# Set to your Resend-verified email for testing (free plan restriction)
RESEND_TEST_EMAIL=

# ── Cloudinary (Hotel Images) — optional ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
